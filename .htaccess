# ============================================================
# Constructora ByB - Apache .htaccess Performance Optimization
# ============================================================

# 1. Caché de largo plazo para assets estáticos (1 año)
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Imágenes: 1 año
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/gif  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # CSS y JavaScript: 1 año (usar cache-busting con ?v= o nombres con hash)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  
  # Fuentes: 1 año
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff  "access plus 1 year"
  ExpiresByType font/ttf   "access plus 1 year"
  
  # HTML: sin caché (siempre fresco)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 2. Cache-Control headers
<IfModule mod_headers.c>
  # Assets inmutables: 1 año, immutable
  <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # CSS y JS con versionado: 1 año
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # HTML: no cache
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  
  # Seguridad: quitar X-Powered-By
  Header unset X-Powered-By
  Header always set X-Content-Type-Options nosniff
  # HSTS: Force browsers to always use HTTPS (eliminates HTTP→HTTPS redirect round-trip)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Preload critical resources via HTTP headers (faster than HTML <link> — arrives before parsing)
  <FilesMatch "index\.html$">
    Header add Link "</css/tailwind.min.css>; rel=preload; as=style"
  </FilesMatch>

  <If "%{REQUEST_URI} =~ m#^/(index\.html)?$#">
    Header add Link "</img/hero-bg-1200w.webp>; rel=preload; as=image; type=image/webp; fetchpriority=high"
  </If>

</IfModule>

# 3. Compresión Gzip / Brotli
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE font/woff
</IfModule>

# 4. Redireccion www → non-www
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.constructorabyb\.com\.ar [NC]
  RewriteRule ^ https://constructorabyb.com.ar%{REQUEST_URI} [R=301,L]
</IfModule>

# 5. Forzar HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# 6. Redirecciones 301: Consolidación de Canibalizaciones y Poda de URLs Zombi (GSC)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- A. Canibalizaciones y Subpáginas Podadas ---
  RewriteRule ^construccion-en-seco/sistema-construccion-en-seco(/.*)?$ /construccion-en-seco/ [R=301,L]
  RewriteRule ^casas-steel-framing/sistema(/.*)?$ /casas-steel-framing/ [R=301,L]
  RewriteRule ^casas-steel-framing/ahorro-energetico(/.*)?$ /casas-steel-framing/ventajas-desventajas/ [R=301,L]
  RewriteRule ^construccion-en-seco/pros-y-contras(/.*)?$ /casas-steel-framing/ventajas-desventajas/ [R=301,L]

  # --- B. URLs Zombi 404 con Tráfico Residual en GSC ---
  # Cluster Cabaña de Troncos -> Catálogo de Casas
  RewriteRule ^cabana-tronco(/.*)?$ /construccion-casas/ [R=301,L]

  # Instalaciones y Estructura -> Páginas Técnicas
  RewriteRule ^instalacion-sanitaria(/.*)?$ /refacciones-inmobiliarias/ [R=301,L]
  RewriteRule ^estructura-casa(/.*)?$ /calculos-de-estructura/ [R=301,L]
  RewriteRule ^entender-planos-de-obra(/.*)?$ /empieza-diseno-de-tu-casa/ [R=301,L]
  RewriteRule ^sistemas-constructivos(/.*)?$ /construccion-en-seco/ [R=301,L]
  RewriteRule ^mezcla-para-revocar-una-pared(/.*)?$ /blog/ [R=301,L]

  # Subpáginas huérfanas de Casas Modernas
  RewriteRule ^casa-moderna/(materiales|tiempo-construccion|5-errores|eficiente-energeticamente|planos|ventajas)(/.*)?$ /casa-moderna/ [R=301,L]

  # Subpáginas huérfanas de Casas de Ladrillo
  RewriteRule ^casa-ladrillo/(resistentes-desastres|tipo-ladrillo|construye-toda-la-vida|eficientes-energeticamente|ladrillos-ecologicos|mantener-tu-casa-de-ladrillo)(/.*)?$ /casa-ladrillo/ [R=301,L]
  RewriteRule ^color-de-ladrillo(/.*)?$ /casa-ladrillo/ [R=301,L]

  # Construcción Industrializada y Paneles -> Steel Framing
  RewriteRule ^casas-conteiners(/.*)?$ /casas-steel-framing/ [R=301,L]
  RewriteRule ^paneles-sip(/.*)?$ /casas-steel-framing/ [R=301,L]
  RewriteRule ^certificado-energetico(/.*)?$ /casas-steel-framing/ [R=301,L]
  RewriteRule ^climas-extremos(/.*)?$ /casas-steel-framing/ [R=301,L]
  RewriteRule ^sistemas-de-refrigeracion-ecologicos(/.*)?$ /casas-steel-framing/ [R=301,L]

  # Refacciones, Humedad y Grietas -> Refacciones Inmobiliarias
  RewriteRule ^arreglar-grietas-en-la-pared(/.*)?$ /refacciones-inmobiliarias/ [R=301,L]
  RewriteRule ^impermeabilizar-paredes-exteriores(/.*)?$ /refacciones-inmobiliarias/ [R=301,L]
  RewriteRule ^tipos-de-encimeras(/.*)?$ /refacciones-inmobiliarias/reformas-cocinas/ [R=301,L]
  RewriteRule ^tipos-de-ventana(/.*)?$ /refacciones-inmobiliarias/ [R=301,L]
  RewriteRule ^disenar-banos-modernos(/.*)?$ /refacciones-inmobiliarias/reformas-cocinas/ [R=301,L]
  RewriteRule ^insonorizar-habitacion(/.*)?$ /construccion-en-seco/ [R=301,L]
  RewriteRule ^aislamientos-termicos(/.*)?$ /casas-steel-framing/ventajas-desventajas/ [R=301,L]

  # Casas de Campo y Rústicas -> Casas Country
  RewriteRule ^casa-americana(/.*)?$ /casa-country/ [R=301,L]
  RewriteRule ^casas-rusticas(/.*)?$ /casa-country/ [R=301,L]
  RewriteRule ^disenos-de-casas-de-campo(/.*)?$ /casa-country/ [R=301,L]
  RewriteRule ^casas-de-campo-modernas(/.*)?$ /casa-country/ [R=301,L]

  # Techos y Piletas
  RewriteRule ^techo-verde(/.*)?$ /mejores-tipos-de-techos/ [R=301,L]
  RewriteRule ^techos-solares(/.*)?$ /mejores-tipos-de-techos/ [R=301,L]
  RewriteRule ^calefaccion-solar-pasiva(/.*)?$ /mejores-tipos-de-techos/ [R=301,L]
  RewriteRule ^construir-pileta-climatizada(/.*)?$ /blog/construir-pileta-hormigon-vs-fibra-tucuman/ [R=301,L]

  # Genéricos e Institucionales
  RewriteRule ^viviendas(/.*)?$ /construccion-casas/ [R=301,L]
  RewriteRule ^mi-casa-en-tucuman(/.*)?$ / [R=301,L]
  RewriteRule ^contratista-general(/.*)?$ / [R=301,L]

  # --- C. Corrección de Typos y Rutas Históricas Indexadas por Error ---
  RewriteRule ^cases-steel-framing(/.*)?$ /casas-steel-framing/ [R=301,L]
  RewriteRule ^mejores-techos-de-chapa(/.*)?$ /mejores-tipos-de-techos/ [R=301,L]
  RewriteRule ^mejores-techos-de-techos(/.*)?$ /mejores-tipos-de-techos/ [R=301,L]
  RewriteRule ^levantan-los-ceramicos-pisos(/.*)?$ /levantan-los-pisos-ceramicos/ [R=301,L]
</IfModule>
